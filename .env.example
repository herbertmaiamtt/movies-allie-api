# ==============================================================================
# Movies Allie API - Exemplo de Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env ou exporte as variáveis no seu terminal / IDE:
#   export TMDB_TOKEN="seu_token_aqui"
# ==============================================================================

# [OBRIGATÓRIO] Token de Acesso de Leitura da API do TMDB (The Movie Database)
# Obtenha seu token gratuitamente em: https://www.themoviedb.org/settings/api
TMDB_TOKEN=seu_tmdb_read_access_token_aqui

# [OPCIONAL EM DEV] Chave Secreta para Assinatura de Tokens JWT (mínimo 256 bits em Base64)
# No perfil 'dev', se omitida, o sistema utiliza o fallback seguro definido em application-dev.properties.
# No perfil 'prod', esta variável é OBRIGATÓRIA.
JWT_SECRET=dGhpcy1pcy1hLXNhbXBsZS1qd3Qtc2VjcmV0LWtleS1mb3ItZGV2LW1vZGU=

# [OPCIONAL] Origens permitidas para requisições CORS (separadas por vírgula)
# Padrão: http://localhost:3000 (desenvolvimento frontend Next.js)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# [PRODUÇÃO APENAS] Credenciais do PostgreSQL (utilizadas apenas com spring.profiles.active=prod)
# DATABASE_URL=jdbc:postgresql://localhost:5432/movies_allie
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
